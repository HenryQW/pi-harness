---
import PageLayout from "blume/components/layout/PageLayout.astro";
import data from "blume:data";

import ExtensionCard from "../components/ExtensionCard.astro";
import Footer from "../components/Footer.astro";
import { extensions } from "../extension-catalog.ts";

const { config } = data;
const featuredExtensions = [
  {
    name: "@henryqw/pi-subagent",
    outcome: "Delegate focused work to isolated Pi roles.",
  },
  {
    name: "@henryqw/pi-task-models",
    outcome: "Choose shared model profiles for Pi tasks.",
  },
  {
    name: "@henryqw/pi-memory",
    outcome: "Keep useful context across Pi sessions.",
  },
].map(({ name, outcome }) => {
  const extension = extensions.find((item) => item.name === name);
  if (!extension) throw new Error(`Missing featured extension: ${name}`);
  return { ...extension, description: outcome };
});
---

<PageLayout
  site={{ title: config.title, description: config.description }}
  logo={config.logo}
  banner={config.banner}
  analytics={config.analytics}
  navigation={data.navigation}
  favicon={config.favicon}
  appleIcon={config.appleIcon}
  fontCssVars={data.fontCssVars}
  themeMode={config.theme.mode}
  searchEnabled={config.search.enabled}
  siteUrl={config.site}
  ogEnabled={config.og.enabled}
  ogImage="/og.png"
  ogImageAlt="Henry Pi Harness — Built on Pi. Tuned by Henry."
  ogImageSize={{ width: 1200, height: 630 }}
  page={{ title: "Henry Pi Harness", description: config.description }}
>
  <div class="mx-auto max-w-360 px-6 py-10 md:px-10 md:py-16 lg:px-16 lg:py-20">
    <header class="max-w-4xl sm:mx-auto sm:text-center">
      <div class="max-w-3xl sm:mx-auto">
        <p class="text-sm font-medium text-accent">Henry Pi Harness</p>
        <h1 class="mt-3 text-5xl font-medium leading-none tracking-tight md:text-6xl">
          Ship better work, faster.
        </h1>
        <p class="mt-5 text-lg text-muted-foreground md:text-xl">Focused context. Less repeat work.</p>
        <div class="mt-7 flex flex-col gap-3 sm:flex-row sm:justify-center">
          <a
            class="inline-flex min-h-11 items-center justify-center rounded-blume bg-accent px-4 py-2 text-sm font-medium text-accent-foreground transition-colors hover:bg-accent/90 focus-visible:ring-2 focus-visible:ring-accent/40"
            href="#extensions"
          >
            Explore extensions
          </a>
          <a
            class="inline-flex min-h-11 items-center justify-center gap-2 rounded-blume border border-border bg-background px-4 py-2 text-sm font-medium transition-colors hover:bg-muted/60 focus-visible:ring-2 focus-visible:ring-accent/40"
            href="https://github.com/HenryQW/pi-harness"
            rel="noopener noreferrer"
            target="_blank"
          >
            View on GitHub <span aria-hidden="true">↗</span><span class="sr-only"> (opens in a new tab)</span>
          </a>
        </div>
        <div class="mt-6 flex items-center justify-center gap-3">
          <a
            class="duration-200 hover:scale-103 hover:-translate-y-1"
            href="https://pi.dev/"
            rel="noopener noreferrer"
            target="_blank"
          >
            <img
              class="size-14 rounded-full md:size-16"
              src="/pi-logo.svg"
              alt="Pi logo"
              width="56"
              height="56"
            />
            <span class="sr-only"> (opens in a new tab)</span>
          </a>
          <p class="text-center text-lg text-muted-foreground md:text-xl">Built on Pi. Tuned by Henry.</p>
          <a
            class="duration-200 hover:scale-103 hover:-translate-y-1"
            href="https://github.com/HenryQW"
            rel="noopener noreferrer"
            target="_blank"
          >
            <img
              class="size-14 rounded-full md:size-16"
              src="/apple-icon.png"
              alt="Henry Wang"
              width="56"
              height="56"
            />
            <span class="sr-only"> (opens in a new tab)</span>
          </a>
        </div>
      </div>
    </header>

    <figure class="mt-10 overflow-hidden md:mt-14">
      <img src="/example.png" alt="Pi running with several extensions from this repository" />
    </figure>

    <section aria-labelledby="start-here-heading" class="mt-16 md:mt-20">
      <div class="border-border border-b pb-4">
        <h2 id="start-here-heading" class="text-2xl font-medium tracking-tight">Start here</h2>
        <p class="mt-1 text-sm text-muted-foreground">Three useful extensions for common Pi workflows.</p>
      </div>
      <div class="mt-6 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {
          featuredExtensions.map((item) => <ExtensionCard {...item} />)
        }
      </div>
    </section>

    <section id="extensions" class="mt-16 scroll-mt-20 md:mt-20">
      <div class="flex items-baseline justify-between gap-4 border-border border-b pb-4">
        <h2 class="text-2xl font-medium tracking-tight">Extensions</h2>
        <span class="text-sm text-muted-foreground">{extensions.length} public extensions</span>
      </div>
      <div class="mt-6 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {
          extensions.map((item) => <ExtensionCard {...item} />)
        }
      </div>
    </section>
  </div>
  <Footer slot="footer" />
</PageLayout>
