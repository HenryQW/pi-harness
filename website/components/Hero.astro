<script>
  const brailleFrames = ["⠋", "⠙", "⠹", "⠸", "⠼", "⠴", "⠦", "⠧", "⠇", "⠏"];

  document.querySelectorAll<HTMLElement>("[data-copy-scope]").forEach((scope) => {
    const comparisons = scope.querySelectorAll<SVGSVGElement>(".hero-comparison");
    if (comparisons.length && !window.matchMedia("(prefers-reduced-motion: reduce)").matches && "IntersectionObserver" in window) {
      const onscreen = new Set<SVGSVGElement>();
      const updateMotion = () => {
        comparisons.forEach((comparison) => {
          comparison.toggleAttribute("data-motion-active", onscreen.has(comparison) && document.visibilityState === "visible");
        });
      };

      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          const comparison = entry.target as SVGSVGElement;
          if (entry.isIntersecting) onscreen.add(comparison);
          else onscreen.delete(comparison);
        });
        updateMotion();
      });
      comparisons.forEach((comparison) => observer.observe(comparison));
      document.addEventListener("visibilitychange", updateMotion);
    }

    const spinner = scope.querySelector<HTMLElement>(".hero-spinner");
    if (spinner && !window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      let frame = 0;
      window.setInterval(() => {
        frame = (frame + 1) % brailleFrames.length;
        spinner.textContent = brailleFrames[frame];
      }, 100);
    }

    const button = scope.querySelector<HTMLButtonElement>("[data-copy-command]");
    const buttonLabel = scope.querySelector<HTMLElement>("[data-copy-label]");
    const status = scope.querySelector<HTMLElement>("[data-copy-status]");
    if (!button || !buttonLabel || !status) return;

    button.addEventListener("click", async () => {
      const command = button.dataset.copyCommand;
      if (!command) {
        status.textContent = "Copy failed. The installer command is unavailable.";
        status.setAttribute("data-error", "true");
        return;
      }

      try {
        if (!navigator.clipboard?.writeText) throw new Error("Clipboard API unavailable");
        await navigator.clipboard.writeText(command);
        buttonLabel.textContent = "Copied";
        status.textContent = "Copied installer command.";
        status.removeAttribute("data-error");
      } catch {
        buttonLabel.textContent = "COPY";
        status.textContent = "Copy failed. Select the command and copy it manually.";
        status.setAttribute("data-error", "true");
      }
    });
  });
</script>

