---
import { npmBadgeUrl } from "../npm-badge.ts";

interface Props {
  description: string;
  directory: string;
  name: string;
  version: string;
}

const item = Astro.props;
---

<a
  class="group flex h-full flex-col rounded-blume border border-border bg-background p-5 transition-colors hover:bg-muted/60 focus-visible:ring-2 focus-visible:ring-accent/40"
  href={`/extensions/${item.directory}`}
>
  <div class="flex items-start justify-between gap-3">
    <h3 class="break-words font-mono text-sm font-medium group-hover:text-accent">{item.name}</h3>
    <span class="shrink-0 font-mono text-xs text-muted-foreground">v{item.version}</span>
  </div>
  <p class="mt-2 flex-1 text-sm text-muted-foreground">{item.description}</p>
  <div class="mt-4 border-border border-t pt-3">
    <img
      alt="Monthly npm downloads"
      class="h-5 w-auto"
      decoding="async"
      height="20"
      loading="lazy"
      src={npmBadgeUrl(item.name)}
      width="144"
    />
  </div>
</a>
