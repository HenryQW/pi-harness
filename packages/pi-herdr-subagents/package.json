{
  "name": "@henryqw/pi-herdr-subagents",
  "version": "0.1.0",
  "description": "Delegate bounded tasks to interactive Pi Workers in Herdr tabs.",
  "keywords": [
    "pi-package",
    "pi",
    "herdr",
    "workers",
    "delegation"
  ],
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "license": "MIT",
  "files": [
    "extensions",
    "internal",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc --noEmit --allowImportingTsExtensions --target ES2022 --module NodeNext --moduleResolution NodeNext --skipLibCheck extensions/subagents.ts internal/protocol.ts internal/worker.ts test/*.test.ts",
    "pack:check": "npm pack --dry-run"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HenryQW/pi-packages.git",
    "directory": "packages/pi-herdr-subagents"
  },
  "bugs": {
    "url": "https://github.com/HenryQW/pi-packages/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "pi": {
    "extensions": [
      "./extensions/subagents.ts"
    ]
  }
}
