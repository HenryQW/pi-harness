{
  "name": "@henryqw/pi-codex-accounts",
  "version": "0.1.1",
  "description": "Enroll multiple OpenAI Codex accounts through Pi's native login flow.",
  "keywords": [
    "pi-package",
    "pi",
    "codex",
    "accounts"
  ],
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "license": "MIT",
  "files": [
    "extensions",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc --noEmit --target ES2022 --module NodeNext --moduleResolution NodeNext --allowImportingTsExtensions --skipLibCheck extensions/codex-accounts.ts test/codex-accounts.test.ts",
    "pack:check": "npm pack --dry-run"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "^0.84.1",
    "@earendil-works/pi-coding-agent": "^0.84.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HenryQW/pi-packages.git",
    "directory": "packages/pi-codex-accounts"
  },
  "bugs": {
    "url": "https://github.com/HenryQW/pi-packages/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "pi": {
    "extensions": [
      "./extensions"
    ]
  }
}
