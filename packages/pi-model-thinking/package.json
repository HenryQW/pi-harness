{
  "name": "@henryqw/pi-model-thinking",
  "version": "0.1.5",
  "description": "Remember Pi thinking level per model.",
  "keywords": [
    "pi-package",
    "pi",
    "thinking",
    "settings"
  ],
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "license": "MIT",
  "files": [
    "extensions",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc --noEmit --allowImportingTsExtensions --target ES2022 --module NodeNext --moduleResolution NodeNext --skipLibCheck extensions/model-thinking.ts test/*.test.ts",
    "pack:check": "npm pack --dry-run"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-coding-agent": "*"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HenryQW/pi-packages.git",
    "directory": "packages/pi-model-thinking"
  },
  "bugs": {
    "url": "https://github.com/HenryQW/pi-packages/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "pi": {
    "extensions": [
      "./extensions"
    ]
  }
}
