{
  "name": "@henryqw/pi-auto-compact",
  "version": "1.0.0",
  "description": "Proactively compact Pi context at a configurable threshold and resume the current task.",
  "keywords": [
    "pi-package",
    "pi",
    "compaction",
    "context"
  ],
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "license": "MIT",
  "files": [
    "extensions",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/*.test.ts",
    "test:live": "PI_AUTO_COMPACT_LIVE=1 node --test test/live.test.ts",
    "typecheck": "tsc --noEmit --allowImportingTsExtensions --target ES2022 --module NodeNext --moduleResolution NodeNext --skipLibCheck extensions/auto-compact.ts test/*.test.ts",
    "pack:check": "npm pack --dry-run"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "^0.84.2",
    "@earendil-works/pi-coding-agent": "^0.84.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HenryQW/pi-packages.git",
    "directory": "packages/pi-auto-compact"
  },
  "bugs": {
    "url": "https://github.com/HenryQW/pi-packages/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "pi": {
    "extensions": [
      "./extensions"
    ]
  },
  "dependencies": {
    "@henryqw/pi-task-models": "^0.1.0"
  }
}
