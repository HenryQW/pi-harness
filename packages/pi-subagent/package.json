{
  "name": "@henryqw/pi-subagent",
  "version": "5.1.1",
  "description": "Delegate bounded single, parallel, or chained tasks to isolated Pi roles.",
  "keywords": [
    "pi-package",
    "pi",
    "subagent",
    "delegation"
  ],
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "license": "MIT",
  "files": [
    "dist",
    "extensions",
    "docs",
    "examples",
    "skills",
    "README.md",
    "CONTEXT.md",
    "LICENSE"
  ],
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "pretypecheck": "npm run build",
    "test": "npm run build && node --test test/*.test.ts",
    "typecheck": "tsc --noEmit --allowImportingTsExtensions --target ES2022 --module NodeNext --moduleResolution NodeNext --skipLibCheck src/*.ts extensions/*.ts test/*.test.ts",
    "prepack": "npm run build",
    "pack:check": "npm pack --dry-run"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "^0.84.3",
    "@earendil-works/pi-coding-agent": "^0.84.3",
    "@earendil-works/pi-tui": "^0.84.3",
    "typebox": "^1.3.15"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HenryQW/pi-packages.git",
    "directory": "packages/pi-subagent"
  },
  "bugs": {
    "url": "https://github.com/HenryQW/pi-packages/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "pi": {
    "extensions": [
      "./extensions/subagent.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "dependencies": {
    "@henryqw/pi-herdr": "^0.4.0",
    "@henryqw/pi-multi-codex": "^0.3.8",
    "@henryqw/pi-task-models": "^1.0.0"
  }
}
