{
  "name": "@henryqw/pi-auto-dag",
  "version": "3.0.0",
  "description": "Plan and run local Delivery Graphs through Pi and Herdr.",
  "keywords": [
    "pi-package",
    "pi",
    "dag",
    "workflow"
  ],
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "license": "MIT",
  "files": [
    "examples",
    "extensions",
    "prompts",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev:ui": "pi --no-extensions --no-skills --no-prompt-templates --no-context-files --no-session --offline -e test/dev/worker-ui.ts",
    "test": "node test/run.mjs",
    "typecheck": "tsc --noEmit --target ES2022 --module NodeNext --moduleResolution NodeNext --allowImportingTsExtensions --skipLibCheck extensions/*.ts src/*.ts test/*.ts test/dev/*.ts",
    "pack:check": "npm pack --dry-run"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "dependencies": {
    "typebox": "1.3.7"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HenryQW/pi-packages.git",
    "directory": "packages/pi-auto-dag"
  },
  "bugs": {
    "url": "https://github.com/HenryQW/pi-packages/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "pi": {
    "extensions": [
      "./extensions/auto-dag.ts",
      "./extensions/worker.ts"
    ]
  }
}
