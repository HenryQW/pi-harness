{
  "name": "@henryqw/pi-1password",
  "version": "0.3.0",
  "description": "Route 1Password lists and approved actions to the Mac where you can approve them.",
  "keywords": ["pi-package", "pi", "1password"],
  "type": "module",
  "engines": { "node": ">=22.19.0" },
  "license": "MIT",
  "files": ["LICENSE", "extensions", "src", "skills", "README.md"],
  "bin": { "pi-1password": "./src/cli.mjs" },
  "scripts": {
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc --noEmit --allowJs --checkJs --allowImportingTsExtensions --target ES2023 --module NodeNext --moduleResolution NodeNext --skipLibCheck extensions/*.ts src/*.mjs test/*.test.ts",
    "pack:check": "npm pack --dry-run"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "^1.3.0",
    "typebox": "^1.3.15"
  },
  "dependencies": { "@henryqw/pi-config-store": "^4.2.0" },
  "devDependencies": { "@earendil-works/pi-coding-agent": "1.3.0" },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HenryQW/pi-harness.git",
    "directory": "extensions/pi-1password"
  },
  "bugs": { "url": "https://github.com/HenryQW/pi-harness/issues" },
  "publishConfig": { "access": "public" },
  "pi": {
    "extensions": ["./extensions/1password.ts"],
    "skills": ["./skills"]
  }
}
