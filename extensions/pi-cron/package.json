{
  "name": "@henryqw/pi-cron",
  "version": "0.2.3",
  "description": "Run scheduled job prompts in new Pi sessions with per-job interval, Role, model, and thinking level.",
  "keywords": [
    "pi-package",
    "pi",
    "cron",
    "schedule",
    "automation"
  ],
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "license": "MIT",
  "files": [
    "LICENSE",
    "extensions",
    "internal",
    "docs",
    "README.md",
    "CONTEXT.md"
  ],
  "scripts": {
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc --noEmit --allowImportingTsExtensions --target ES2022 --module NodeNext --moduleResolution NodeNext --skipLibCheck extensions/cron.ts internal/*.ts test/*.test.ts",
    "pack:check": "npm pack --dry-run"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "^1.0.0"
  },
  "dependencies": {
    "@henryqw/pi-config-store": "^3.0.0",
    "@henryqw/pi-subagent": "^25.0.0 || ^26.0.0",
    "@henryqw/pi-task-models": "^8.0.0",
    "proper-lockfile": "^4.1.2"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.0.0",
    "@types/proper-lockfile": "^4.1.4"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HenryQW/pi-harness.git",
    "directory": "extensions/pi-cron"
  },
  "bugs": {
    "url": "https://github.com/HenryQW/pi-harness/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "pi": {
    "extensions": [
      "./extensions/cron.ts"
    ]
  }
}
