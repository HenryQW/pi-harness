{
  "name": "@henryqw/pi-orchestrator",
  "version": "4.1.0",
  "description": "Run durable checked implementation task graphs for Pi.",
  "keywords": [
    "pi-package",
    "pi",
    "orchestration",
    "dag"
  ],
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "license": "MIT",
  "files": [
    "LICENSE",
    "dist",
    "extensions",
    "src",
    "skills",
    "docs",
    "README.md",
    "CONTEXT.md"
  ],
  "pi": {
    "extensions": [
      "./extensions/orchestrator.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc --noEmit --allowImportingTsExtensions --target ES2022 --module NodeNext --moduleResolution NodeNext --types node --skipLibCheck extensions/*.ts src/*.ts test/*.test.ts",
    "prepack": "npm run build",
    "pack:check": "npm pack --dry-run"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "^0.86.0"
  },
  "dependencies": {
    "@henryqw/pi-config-store": "^2.0.0",
    "@henryqw/pi-herdr": "^0.4.7",
    "@henryqw/pi-process": "^0.1.0",
    "@henryqw/pi-subagent": "^18.0.0",
    "@henryqw/pi-task-models": "^7.0.0",
    "proper-lockfile": "^4.1.2",
    "typebox": "^1.3.15"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.86.0",
    "@types/node": "^26.4.1",
    "@types/proper-lockfile": "^4.1.4"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HenryQW/pi-harness.git",
    "directory": "extensions/pi-orchestrator"
  },
  "bugs": {
    "url": "https://github.com/HenryQW/pi-harness/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
