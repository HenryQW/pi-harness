{
  "name": "@henryqw/pi-herdr-tools",
  "version": "1.2.0",
  "description": "Clone, name, and finish Pi conversations in Herdr, with mergeable side questions.",
  "keywords": ["pi-package", "pi", "herdr", "session", "clone", "side-thread", "title"],
  "type": "module",
  "engines": { "node": ">=22.19.0" },
  "license": "MIT",
  "files": ["LICENSE", "extensions", "internal", "docs", "README.md"],
  "scripts": {
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc --noEmit --allowImportingTsExtensions --target ES2022 --module NodeNext --moduleResolution NodeNext --skipLibCheck extensions/*.ts internal/*.ts test/*.test.ts",
    "pack:check": "npm pack --dry-run"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "^1.1.0",
    "@earendil-works/pi-coding-agent": "^1.1.0"
  },
  "dependencies": {
    "@henryqw/pi-config-store": "^3.0.0",
    "@henryqw/pi-herdr": "^0.4.9",
    "@henryqw/pi-task-models": "^8.0.0"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "1.1.0",
    "@earendil-works/pi-coding-agent": "1.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HenryQW/pi-harness.git",
    "directory": "extensions/pi-herdr-tools"
  },
  "bugs": { "url": "https://github.com/HenryQW/pi-harness/issues" },
  "publishConfig": { "access": "public" },
  "pi": { "extensions": ["./extensions/index.ts"] }
}
