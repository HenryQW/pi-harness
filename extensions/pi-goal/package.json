{
  "name": "@henryqw/pi-goal",
  "version": "0.1.2",
  "description": "Persistent Pi goals that continue automatically until completion is proven with evidence.",
  "keywords": [
    "pi-package",
    "pi",
    "goal",
    "autonomous"
  ],
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "license": "MIT",
  "files": [
    "LICENSE",
    "docs",
    "extensions",
    "README.md"
  ],
  "scripts": {
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc --noEmit --allowImportingTsExtensions --target ES2023 --module NodeNext --moduleResolution NodeNext --skipLibCheck extensions/goal.ts test/*.test.ts",
    "pack:check": "npm pack --dry-run"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "^1.3.0",
    "typebox": "^1.3.15"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HenryQW/pi-harness.git",
    "directory": "extensions/pi-goal"
  },
  "bugs": {
    "url": "https://github.com/HenryQW/pi-harness/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "pi": {
    "extensions": [
      "./extensions/goal.ts"
    ]
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.3.0"
  }
}
