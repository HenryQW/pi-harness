{
  "name": "@henryqw/pi-auto-dag",
  "version": "9.0.0",
  "description": "Run durable dependent Pi tasks serially in one Git workspace.",
  "keywords": [
    "pi-package",
    "pi",
    "dag",
    "workflow"
  ],
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "license": "MIT",
  "files": [
    "extensions",
    "src",
    "README.md",
    "CONTEXT.md",
    "LICENSE"
  ],
  "scripts": {
    "pretest": "pnpm --filter @henryqw/pi-subagent build",
    "test": "node --test test/*.test.ts",
    "pretypecheck": "pnpm --filter @henryqw/pi-subagent build",
    "typecheck": "tsc --noEmit --allowImportingTsExtensions --target ES2022 --module NodeNext --moduleResolution NodeNext --skipLibCheck extensions/*.ts src/*.ts test/*.test.ts",
    "pack:check": "npm pack --dry-run"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "^0.85.1",
    "@earendil-works/pi-coding-agent": "^0.85.1"
  },
  "dependencies": {
    "@henryqw/pi-subagent": "^15.0.2",
    "@henryqw/pi-task-models": "^5.0.2",
    "proper-lockfile": "^4.1.2",
    "typebox": "^1.3.15"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HenryQW/pi-harness.git",
    "directory": "extensions/pi-auto-dag"
  },
  "bugs": {
    "url": "https://github.com/HenryQW/pi-harness/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "pi": {
    "extensions": [
      "./extensions/auto-dag.ts"
    ]
  },
  "devDependencies": {
    "@types/proper-lockfile": "^4.1.4"
  }
}
