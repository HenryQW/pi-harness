{
  "name": "@henryqw/pi-auto-compact",
  "version": "4.1.0",
  "description": "Trim repeated reads and compact Pi context at a configurable threshold.",
  "keywords": [
    "pi-package",
    "pi",
    "compaction",
    "context"
  ],
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "license": "MIT",
  "files": [
    "LICENSE",
    "extensions",
    "README.md"
  ],
  "scripts": {
    "test": "node --test test/*.test.ts",
    "test:live": "PI_AUTO_COMPACT_LIVE=1 node --test test/live.test.ts",
    "typecheck": "tsc --noEmit --allowImportingTsExtensions --target ES2022 --module NodeNext --moduleResolution NodeNext --skipLibCheck extensions/auto-compact.ts test/*.test.ts",
    "pack:check": "npm pack --dry-run"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "^0.87.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HenryQW/pi-harness.git",
    "directory": "extensions/pi-auto-compact"
  },
  "bugs": {
    "url": "https://github.com/HenryQW/pi-harness/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "pi": {
    "extensions": [
      "./extensions"
    ]
  },
  "dependencies": {
    "@henryqw/pi-config-store": "^2.0.0",
    "@henryqw/pi-task-models": "^7.0.0"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.87.0"
  }
}
