{
	"name": "@henryqw/pi-memory",
	"version": "6.0.1",
	"description": "Auto-managed markdown memory for Pi: capped MEMORY.md/USER.md entry stores with frozen session snapshots.",
	"keywords": [
		"pi-package",
		"pi",
		"memory"
	],
	"type": "module",
	"engines": {
		"node": ">=22.19.0"
	},
	"license": "MIT",
	"files": [
		"LICENSE",
		"docs",
		"extensions",
		"src",
		"README.md"
	],
	"scripts": {
		"test": "node --test test/*.test.ts",
		"typecheck": "tsc --noEmit --allowImportingTsExtensions --target ES2022 --module NodeNext --moduleResolution NodeNext --skipLibCheck extensions/*.ts src/*.ts test/*.test.ts",
		"pack:check": "npm pack --dry-run"
	},
	"dependencies": {
		"@henryqw/pi-ask-question": "^1.0.0",
		"@henryqw/pi-config-store": "^1.0.0",
		"@henryqw/pi-task-models": "^5.0.0",
		"proper-lockfile": "^4.1.2"
	},
	"peerDependencies": {
		"@earendil-works/pi-ai": "^0.85.0",
		"@earendil-works/pi-coding-agent": "^0.85.0",
		"@earendil-works/pi-tui": "^0.85.0",
		"typebox": "^1.3.15"
	},
	"devDependencies": {
		"@types/proper-lockfile": "^4.1.4"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/HenryQW/pi-harness.git",
		"directory": "extensions/pi-memory"
	},
	"bugs": {
		"url": "https://github.com/HenryQW/pi-harness/issues"
	},
	"publishConfig": {
		"access": "public"
	},
	"pi": {
		"extensions": [
			"./extensions/memory.ts"
		]
	}
}
