{
  "name": "@henryqw/pi-herdr-btw",
  "version": "2.0.1",
  "description": "Open and merge tool-enabled Pi side threads in Herdr panes.",
  "keywords": [
    "pi-package",
    "pi",
    "herdr",
    "side-thread",
    "btw"
  ],
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "license": "MIT",
  "files": [
    "LICENSE",
    "extensions",
    "internal",
    "README.md"
  ],
  "scripts": {
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc --noEmit --allowImportingTsExtensions --target ES2022 --module NodeNext --moduleResolution NodeNext --skipLibCheck extensions/btw.ts internal/*.ts test/*.test.ts",
    "pack:check": "npm pack --dry-run"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "^0.84.4",
    "@earendil-works/pi-coding-agent": "^0.84.4"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HenryQW/pi-harness.git",
    "directory": "extensions/pi-herdr-btw"
  },
  "bugs": {
    "url": "https://github.com/HenryQW/pi-harness/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "pi": {
    "extensions": [
      "./extensions/btw.ts"
    ]
  },
  "dependencies": {
    "@henryqw/pi-config-store": "^0.1.0",
    "@henryqw/pi-herdr": "^0.4.0",
    "@henryqw/pi-task-models": "^4.0.0"
  }
}
