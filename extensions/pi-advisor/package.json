{
  "name": "@henryqw/pi-advisor",
  "version": "0.1.1",
  "description": "Opt-in second-model review of each Pi agent run after it settles, with graded notes and one blocker follow-up.",
  "keywords": [
    "pi-package",
    "pi",
    "advisor",
    "review"
  ],
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "license": "MIT",
  "files": [
    "LICENSE",
    "docs",
    "extensions",
    "README.md"
  ],
  "scripts": {
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc --noEmit --allowImportingTsExtensions --target ES2023 --module NodeNext --moduleResolution NodeNext --skipLibCheck extensions/advisor.ts test/*.test.ts",
    "pack:check": "npm pack --dry-run"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "^1.3.0"
  },
  "dependencies": {
    "@henryqw/pi-task-models": "^9.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HenryQW/pi-harness.git",
    "directory": "extensions/pi-advisor"
  },
  "bugs": {
    "url": "https://github.com/HenryQW/pi-harness/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "pi": {
    "extensions": [
      "./extensions/advisor.ts"
    ]
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.3.0"
  }
}
