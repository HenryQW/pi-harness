{
  "name": "@henryqw/pi-magpie",
  "version": "0.2.0",
  "description": "Show Magpie provider quota in Pi.",
  "keywords": ["pi-package", "pi", "magpie", "quota"],
  "type": "module",
  "engines": { "node": ">=22.19.0" },
  "license": "MIT",
  "files": ["LICENSE", "extensions", "README.md"],
  "scripts": {
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc --noEmit --allowImportingTsExtensions --target ES2023 --module NodeNext --moduleResolution NodeNext --skipLibCheck extensions/*.ts test/*.test.ts",
    "pack:check": "npm pack --dry-run"
  },
  "peerDependencies": { "@earendil-works/pi-coding-agent": "^1.5.0" },
  "devDependencies": { "@earendil-works/pi-coding-agent": "1.5.2" },
  "repository": { "type": "git", "url": "git+https://github.com/HenryQW/pi-harness.git", "directory": "extensions/pi-magpie" },
  "bugs": { "url": "https://github.com/HenryQW/pi-harness/issues" },
  "publishConfig": { "access": "public" },
  "pi": { "extensions": ["./extensions/magpie.ts"] }
}
