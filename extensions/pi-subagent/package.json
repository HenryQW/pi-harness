{
  "name": "@henryqw/pi-subagent",
  "version": "19.0.0",
  "description": "Delegate bounded direct work or durable checked isolated task graphs to Pi roles.",
  "keywords": [
    "pi-package",
    "pi",
    "subagent",
    "delegation"
  ],
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "license": "MIT",
  "files": [
    "LICENSE",
    "dist",
    "extensions",
    "docs",
    "examples",
    "README.md",
    "CONTEXT.md",
    "skills"
  ],
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "pretypecheck": "npm run build",
    "test": "npm run build && node --test test/*.test.ts",
    "typecheck": "tsc --noEmit --allowImportingTsExtensions --target ES2022 --module NodeNext --moduleResolution NodeNext --skipLibCheck src/*.ts extensions/*.ts test/*.test.ts",
    "prepack": "npm run build",
    "pack:check": "npm pack --dry-run"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": ">=0.86.0 <0.88.0",
    "@earendil-works/pi-coding-agent": ">=0.86.0 <0.88.0",
    "@earendil-works/pi-tui": ">=0.86.0 <0.88.0",
    "typebox": "^1.3.15"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HenryQW/pi-harness.git",
    "directory": "extensions/pi-subagent"
  },
  "bugs": {
    "url": "https://github.com/HenryQW/pi-harness/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "pi": {
    "extensions": [
      "./extensions/subagent.ts"
    ],
    "skills": [
      "./skills"
    ],
    "image": "https://raw.githubusercontent.com/HenryQW/pi-harness/main/extensions/pi-subagent/example.png"
  },
  "dependencies": {
    "@henryqw/pi-config-store": "^2.0.0",
    "@henryqw/pi-herdr": "^0.4.7",
    "@henryqw/pi-multi-codex": "^2.0.0",
    "@henryqw/pi-process": "^0.2.0",
    "@henryqw/pi-task-models": "^7.0.0",
    "proper-lockfile": "^4.1.2"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.87.0",
    "@earendil-works/pi-coding-agent": "0.87.0",
    "@earendil-works/pi-tui": "0.87.0",
    "@types/proper-lockfile": "^4.1.4"
  }
}
